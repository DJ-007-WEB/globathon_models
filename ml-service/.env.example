# Shared with the application backend and AI-model service
# Keep blank only for local development. Production requires a strong shared secret.
INTERNAL_SERVICE_TOKEN=
ENVIRONMENT=development
MAX_UPLOAD_BYTES=26214400
MAX_CONCURRENT_ANALYSES=2
# Parser resource limits (CSV rows/columns, expanded XLSX size in bytes).
MAX_ROWS=1000000
MAX_COLUMNS=500
MAX_XLSX_UNCOMPRESSED_BYTES=262144000
