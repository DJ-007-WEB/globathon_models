# Local model services (bind them to loopback; do not expose ports publicly)
LLM_API_URL=http://127.0.0.1:8000
ML_API_URL=http://127.0.0.1:8002
LLM_TIMEOUT_SECONDS=180
ML_TIMEOUT_SECONDS=300

# Set the same high-entropy random value in backend, ML service and AI service.
# Required when ENVIRONMENT=production.
INTERNAL_SERVICE_TOKEN=
ENVIRONMENT=development

# Maximum accepted CSV/XLSX upload size (bytes): 25 MiB
MAX_UPLOAD_BYTES=26214400

# Exact frontend origin(s), never use wildcard origins in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
