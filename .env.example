# Local service endpoints
ML_API_URL=http://127.0.0.1:8002
ML_TIMEOUT_SECONDS=300
LLM_API_URL=http://127.0.0.1:8000
LLM_TIMEOUT_SECONDS=180

# Use the same high-entropy value in backend, ML and AI-model services.
# Required when ENVIRONMENT=production; optional for local development.
INTERNAL_SERVICE_TOKEN=
ENVIRONMENT=development
MAX_UPLOAD_BYTES=26214400

# Exact browser origins; Vite defaults to 127.0.0.1:5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
