# Leave MODEL_NAME empty to read base_model_name_or_path from adapter_config.json.
# Set it explicitly only when it exactly matches the adapter's training base model.
MODEL_NAME=
ADAPTER_PATH=models/solar-qwen-lora-final
# Too small a budget truncates the JSON answer; 700 fits the full explanation.
MAX_NEW_TOKENS=700
# Prompt token budget (evidence + instructions). Keep at 7600 unless the model context allows more.
MAX_INPUT_TOKENS=7600
# Set true for local demo startup warmup; production always warms before serving.
LLM_WARMUP_ON_STARTUP=false

# Must match INTERNAL_SERVICE_TOKEN in backend and ML service.
# Blank is permitted only for local development.
INTERNAL_SERVICE_TOKEN=
ENVIRONMENT=development
# Generation path: auto (fine-tuned adapter first, base model fallback), adapter, or base.
LLM_ADAPTER_MODE=auto
# Stop starting new generation attempts after this many seconds; keep below the
# backend's LLM_TIMEOUT_SECONDS (300).
LLM_TIME_BUDGET_SECONDS=240
