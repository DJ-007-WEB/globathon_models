# Local service endpoints (loopback only for local development)
ML_API_URL=http://127.0.0.1:8002
ML_TIMEOUT_SECONDS=300
LLM_API_URL=http://127.0.0.1:8000
LLM_TIMEOUT_SECONDS=180

# Shared backend-to-ML/LLM secret. Set the identical random value in all 3 services.
INTERNAL_SERVICE_TOKEN=
# Browser-to-backend deployment gate. Keep out of frontend source code.
# Production requires this value; local development may leave it empty.
API_ACCESS_TOKEN=
ENVIRONMENT=development
MAX_UPLOAD_BYTES=26214400
MAX_CONCURRENT_ANALYSES=2

# Exact trusted frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB account and analysis storage
# Add your MongoDB Atlas connection string locally; do not commit .env.
MONGODB_URI=
MONGODB_DATABASE=solarsleuth

# JWT signing secret: generate a unique random value (at least 32 characters).
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=720
